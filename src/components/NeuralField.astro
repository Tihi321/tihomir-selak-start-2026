<!-- Mirrors tihomir-selak-2026/src/components/system/NeuralField.astro, keep in sync. --><!-- Static nebula haze (dark only), painted once instead of every frame. -->
<div class="neural-field neural-field__haze" aria-hidden="true"></div>
<canvas class="neural-field" aria-hidden="true"></canvas>
<!-- Probes exist only so the script can read resolved light-dark() colors. -->
<span class="neural-field__probe" aria-hidden="true">
  <i class="neural-field__swatch neural-field__swatch--synapse"></i>
  <i class="neural-field__swatch neural-field__swatch--phosphor"></i>
  <i class="neural-field__swatch neural-field__swatch--carbon"></i>
</span>

<style>
  .neural-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }

  /* Glow sprite profile (1 -> 0.35 at 35% -> 0) at 15% opacity. */
  .neural-field__haze {
    --haze: light-dark(
      transparent,
      color-mix(in srgb, var(--c-synapse) 15%, transparent)
    );
    --haze-mid: light-dark(
      transparent,
      color-mix(in srgb, var(--c-synapse) 5%, transparent)
    );
    background:
      radial-gradient(
        55vmax circle at 92% 5%,
        var(--haze),
        var(--haze-mid) 35%,
        transparent
      ),
      radial-gradient(
        50vmax circle at 4% 95%,
        var(--haze),
        var(--haze-mid) 35%,
        transparent
      ),
      radial-gradient(
        38vmax circle at 85% 95%,
        var(--haze),
        var(--haze-mid) 35%,
        transparent
      );
  }

  .neural-field__probe {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }

  .neural-field__swatch--synapse {
    color: var(--c-synapse);
  }

  .neural-field__swatch--phosphor {
    color: var(--c-phosphor);
  }

  .neural-field__swatch--carbon {
    color: var(--c-carbon);
  }
</style>

<script>
  import { startNeuralField } from '../scripts/neural-field';

  const canvas = document.querySelector<HTMLCanvasElement>(
    'canvas.neural-field',
  );
  const synapse = document.querySelector<HTMLElement>(
    '.neural-field__swatch--synapse',
  );
  const phosphor = document.querySelector<HTMLElement>(
    '.neural-field__swatch--phosphor',
  );
  const carbon = document.querySelector<HTMLElement>(
    '.neural-field__swatch--carbon',
  );

  if (canvas && synapse && phosphor && carbon) {
    startNeuralField(canvas, { synapse, phosphor, carbon });
  }
</script>
